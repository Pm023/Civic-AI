# CivicAI Backend Configuration
PROJECT_NAME=CivicAI
DATABASE_URL=sqlite:///./civic_ai.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/civicai

SECRET_KEY=change_this_to_a_robust_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

MOCK_AI=true
IMAGE_MODEL_PATH=models/image_classifier/best.pt
TEXT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

DUPLICATE_RADIUS_METERS=100.0
DUPLICATE_SIMILARITY_THRESHOLD=0.85
